# Copy this file to ".env" and fill in the values. Never commit the real ".env".
# Where to find the values: Supabase dashboard -> Project Settings -> API (see docs/SETUP.md).

# Same project URL and public ("anon" / "publishable") key, twice:
# the VITE_ ones are used by the browser, the others by the server.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SECRET - server only. Never put this in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set to "true" only after you configure Google login in Supabase.
VITE_ENABLE_GOOGLE_LOGIN=

# Optional: CJ Dropshipping (server only).
CJ_API_KEY=

# PayPal (server only). Get these in developer.paypal.com -> Apps & Credentials.
# PAYPAL_ENV = "sandbox" for test money, "live" for real money.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Shared secret between the website and the database for confirming payments (already set on Vercel).
ORDER_SECRET=
